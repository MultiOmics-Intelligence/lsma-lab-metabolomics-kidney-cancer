{
  "workflow": "metabolomics",
  "workflow_version": "1.0.0",
  "lab_run_time": "1 min 0 s (upload of the table: about 1 s)",
  "validation_run_time": "30 s (independent cohort, 18 pairs)",
  "robustness_run_time": "1 min 0 s (without the 3 low-signal pairs)",
  "parameters": {
    "input": {
      "sample_type_column": null,
      "run_order_column": null,
      "sample_preparation": {
        "version": 1,
        "condition": "tissue",
        "relabel": {},
        "groups": [
          "normal",
          "tumour"
        ],
        "reference": "normal",
        "excluded": {},
        "covariates": [
          "patient"
        ],
        "pairing": "patient"
      }
    },
    "qc": {
      "max_missing_fraction": 0.5,
      "max_qc_rsd": 30,
      "min_sample_to_blank": 3,
      "group_column": null
    },
    "normalisation": {
      "method": "pqn",
      "imputation": "half_min"
    },
    "exploration": {
      "scaling": "pareto",
      "color_by": null,
